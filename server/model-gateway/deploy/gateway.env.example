# Copy to a server-only environment file with mode 0600. Never commit real values.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787
GATEWAY_ISSUER=https://gateway.example.com
GATEWAY_DATABASE_PATH=/var/lib/echolens-gateway/gateway.sqlite

GATEWAY_MODEL=deepseek-chat
GATEWAY_PROTOCOLS=chat_completions,responses
GATEWAY_DEFAULT_PROTOCOL=chat_completions
GATEWAY_MAX_CONTEXT_TOKENS=64000

GATEWAY_UPSTREAM_CHAT_BASE_URL=https://api.deepseek.com/v1
GATEWAY_UPSTREAM_CHAT_API_KEY=
GATEWAY_UPSTREAM_RESPONSES_BASE_URL=https://api.openai.com/v1
GATEWAY_UPSTREAM_RESPONSES_API_KEY=
GATEWAY_DEVICE_APPROVAL_SECRET=

GATEWAY_MAX_CONCURRENT_REQUESTS=4
GATEWAY_MAX_REQUESTS_PER_MINUTE=60
GATEWAY_MONTHLY_REQUEST_QUOTA=10000
GATEWAY_MONTHLY_TOKEN_QUOTA=10000000
GATEWAY_MAX_UPSTREAM_DURATION_MS=120000
GATEWAY_MAX_UPSTREAM_RESPONSE_BYTES=67108864
