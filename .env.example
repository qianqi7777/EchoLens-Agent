# 必须显式选择 direct 或 gateway，不会自动回退到另一条路由。
AGENT_MODEL_ROUTE=direct

# direct: 用户自定义的 OpenAI-compatible API。
AGENT_DIRECT_MODEL=deepseek-chat
AGENT_DIRECT_BASE_URL=https://api.deepseek.com/v1
AGENT_DIRECT_PROTOCOL=chat_completions
AGENT_DIRECT_CREDENTIAL_REF=env:AGENT_DIRECT_API_KEY
AGENT_DIRECT_PRIVACY=full-context
AGENT_DIRECT_STREAMING=true
# AGENT_DIRECT_API_KEY=仅用于本地临时环境或 CI，请勿提交真实值

# gateway: EchoLens 远程登录与模型代理。启用时将 AGENT_MODEL_ROUTE 改为 gateway。
# AGENT_GATEWAY_URL=https://gateway.example.com
# AGENT_GATEWAY_MODEL=deepseek-chat
# AGENT_GATEWAY_CREDENTIAL_REF=gateway-token:default
# full-context 发送受控全文；evidence 只发送证据摘要；metadata 只发送工具元数据。
# AGENT_GATEWAY_PRIVACY=metadata
# AGENT_GATEWAY_PRIVACY_CONFIRMED=true
# 正式 Gateway Token 由 npm run gateway:login 保存到用户级受保护存储，不写 .env.local。

# Agent 可以读取的代码目录；默认是启动命令所在目录。
AGENT_WORKSPACE_ROOT=D:\path\to\your\project

# v0.5 Docker Sandbox。命令只挂载过滤后的临时工作区快照，不挂载项目根。
# 镜像必须已存在于本机；运行时使用 --pull never，避免隐式下载。
AGENT_SANDBOX_IMAGE=node:22-bookworm-slim
# AGENT_DOCKER_EXECUTABLE=docker
# Linux 默认映射当前非 root uid:gid；Windows 默认使用 65532:65532，可按镜像调整。
# AGENT_SANDBOX_USER=65532:65532
