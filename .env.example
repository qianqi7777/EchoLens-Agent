# local: Ollama / LM Studio / vLLM 等 OpenAI-compatible 服务
AGENT_MODEL_ROUTE=local
AGENT_LOCAL_MODEL=qwen3-coder
AGENT_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
AGENT_LOCAL_API_KEY=local

# Agent 可以读取的代码目录；默认是启动命令所在目录
AGENT_WORKSPACE_ROOT=D:\path\to\your\project

# direct 路由按需启用
# AGENT_DIRECT_MODEL=your-model
# AGENT_DIRECT_BASE_URL=https://your-provider.example/v1
# AGENT_DIRECT_API_KEY=your-key
# AGENT_DIRECT_PRIVACY=evidence
