{
  "name": "echolens-agent",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "setup": "tsx src/cli.ts --setup",
    "gateway:server": "tsx server/model-gateway/src/main.ts",
    "gateway:build": "tsc -p server/model-gateway/tsconfig.json",
    "gateway:test": "tsx --test agent-test/tests/server/model-gateway/src/server.test.ts",
    "gateway:login": "tsx src/gateway-cli.ts login",
    "gateway:refresh": "tsx src/gateway-cli.ts refresh",
    "gateway:logout": "tsx src/gateway-cli.ts logout",
    "gateway:status": "tsx src/gateway-cli.ts status",
    "verify:provider": "tsx agent-test/scripts/verify-provider.ts",
    "verify:docker": "tsx agent-test/scripts/verify-docker-sandbox.ts",
    "eval": "tsx agent-test/src/eval-cli.ts",
    "agent-test:web": "tsx agent-test/src/server.ts",
    "agent-test:test": "tsx --test agent-test/tests/agent-test/engine.test.ts",
    "eval:smoke": "tsx agent-test/src/eval-cli.ts --task agent-test/fixtures/evals/answer-smoke.task.json --candidate agent-test/fixtures/evals/answer-smoke.candidate.json --results .echolens/evals/smoke-results.jsonl --suite smoke",
    "test:classification": "tsx agent-test/scripts/check-test-classification.ts",
    "test:unit": "tsx --test agent-test/tests/agent-test/engine.test.ts agent-test/tests/src/commands/command-catalog.test.ts agent-test/tests/src/config/startup-config.test.ts agent-test/tests/src/context/context-manager.test.ts agent-test/tests/src/credentials/gateway-token-store.test.ts agent-test/tests/src/evals/dynamic-metrics.test.ts agent-test/tests/src/orchestration/task-command.test.ts agent-test/tests/src/orchestration/task-queue.test.ts agent-test/tests/src/runtime/approval.test.ts agent-test/tests/src/runtime/edit-loop.test.ts agent-test/tests/src/runtime/file-lock.test.ts agent-test/tests/src/runtime/runtime.test.ts agent-test/tests/src/runtime/sandbox-tools.test.ts agent-test/tests/src/runtime/structured-output.test.ts agent-test/tests/src/runtime/structured-patch.test.ts agent-test/tests/src/runtime/tool-errors.test.ts agent-test/tests/src/runtime/tool-scheduler.test.ts agent-test/tests/src/runtime/tool-schema.test.ts agent-test/tests/src/runtime/verification.test.ts agent-test/tests/src/runtime/workspace-manager.test.ts agent-test/tests/src/sandbox/artifact-store.test.ts agent-test/tests/src/sandbox/process-runner.test.ts agent-test/tests/src/tui.test.ts",
    "test:contract": "tsx --test agent-test/tests/src/code-intelligence/code-intelligence.test.ts agent-test/tests/src/context/instruction-contract.test.ts agent-test/tests/src/evals/eval-harness.test.ts agent-test/tests/src/evals/file-runner.test.ts agent-test/tests/src/mcp/mcp-client.test.ts agent-test/tests/src/orchestration/subagent.test.ts agent-test/tests/src/providers/gateway/gateway-client.test.ts agent-test/tests/src/providers/openai-compatible/openai-compatible.test.ts agent-test/tests/src/providers/openai-compatible/provider-hardening.test.ts agent-test/tests/src/providers/openai-compatible/provider-streaming.test.ts agent-test/tests/src/runtime/model-router.test.ts agent-test/tests/src/sandbox/docker-sandbox.test.ts agent-test/tests/src/session/jsonl-event-store.test.ts agent-test/tests/src/session/session-runtime.test.ts agent-test/tests/server/model-gateway/src/server.test.ts",
    "test:security": "tsx --test agent-test/tests/src/runtime/guardrail.test.ts agent-test/tests/src/runtime/path-policy.test.ts agent-test/tests/src/runtime/tool-output.test.ts",
    "test:performance": "tsx --test agent-test/tests/src/runtime/workspace-tools.performance.test.ts",
    "test": "npm run test:classification && npm run test:unit && npm run test:contract && npm run test:security",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "check:ci": "npm run check && npm run test:performance",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "string-width": "^8.2.2",
    "tree-sitter": "^0.21.1",
    "tree-sitter-typescript": "^0.23.2",
    "typescript-language-server": "^6.0.0",
    "vscode-jsonrpc": "^9.0.1",
    "wrap-ansi": "^10.0.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  }
}
