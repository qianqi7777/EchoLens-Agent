{
  "name": "echolens-agent",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "setup": "tsx src/cli.ts --setup",
    "gateway:server": "tsx server/model-gateway/src/main.ts",
    "gateway:build": "tsc -p server/model-gateway/tsconfig.json",
    "gateway:test": "tsx --test agent-test/tests/server/model-gateway/src/server.test.ts",
    "gateway:login": "tsx src/gateway-cli.ts login",
    "gateway:refresh": "tsx src/gateway-cli.ts refresh",
    "gateway:logout": "tsx src/gateway-cli.ts logout",
    "gateway:status": "tsx src/gateway-cli.ts status",
    "verify:provider": "tsx agent-test/scripts/verify-provider.ts",
    "verify:docker": "tsx agent-test/scripts/verify-docker-sandbox.ts",
    "eval": "tsx agent-test/src/eval-cli.ts",
    "agent-test:web": "tsx agent-test/src/server.ts",
    "agent-test:web:test": "node agent-test/scripts/verify-web.mjs",
    "agent-test:test": "tsx --test agent-test/tests/agent-test/engine.test.ts",
    "eval:smoke": "tsx agent-test/src/eval-cli.ts --task agent-test/fixtures/evals/answer-smoke.task.json --candidate agent-test/fixtures/evals/answer-smoke.candidate.json --results .echolens/evals/smoke-results.jsonl --suite smoke",
    "test:classification": "tsx agent-test/scripts/run-tests.ts --check",
    "test:unit": "tsx agent-test/scripts/run-tests.ts unit",
    "test:contract": "tsx agent-test/scripts/run-tests.ts contract",
    "test:security": "tsx agent-test/scripts/run-tests.ts security",
    "test:performance": "tsx agent-test/scripts/run-tests.ts performance",
    "test": "npm run test:classification && npm run test:unit && npm run test:contract && npm run test:security",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "check:ci": "npm run check && npm run test:performance",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "ink": "^7.1.1",
    "lucide": "^1.41.0",
    "react": "^19.2.8",
    "string-width": "^8.2.2",
    "tree-sitter": "^0.21.1",
    "tree-sitter-typescript": "^0.23.2",
    "typescript-language-server": "^6.0.0",
    "vscode-jsonrpc": "^9.0.1",
    "wrap-ansi": "^10.0.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  }
}
